# Shared local runtime configuration
# Copy this file to .env.local and replace placeholder values locally.

DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/xiaoyu
XIAOYU_TRANSLATION_RUNTIME_REPOSITORY=prisma
XIAOYU_TRANSLATION_STORAGE_ADAPTER=local

XIAOYU_AI_PROVIDER=openai
XIAOYU_AI_MODEL=qwen3.6-plus
XIAOYU_AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
XIAOYU_AI_TIMEOUT_SECONDS=60
XIAOYU_AI_MAX_RETRIES=2
XIAOYU_AI_RETRY_BASE_MS=1500
XIAOYU_AI_BATCH_SIZE=20
XIAOYU_AI_MAX_CONCURRENCY=6
XIAOYU_AI_BATCH_FALLBACK_ENABLED=true
XIAOYU_AI_API_KEY=replace-with-your-local-secret

# Optional local override for the Python runtime used by document workers
# XIAOYU_PYTHON_BIN=/absolute/path/to/python3
